#!/usr/bin/env bats

# Bats is a testing framework for Bash
# Documentation https://bats-core.readthedocs.io/en/stable/
# Bats libraries documentation https://github.com/ztombol/bats-docs

# For local tests, install bats-core (brew install bats-core) and the assertion
# libraries from their git repos (they are not on Homebrew), e.g. on macOS:
#   git clone --depth 1 https://github.com/bats-core/bats-assert /opt/homebrew/lib/bats-assert
#   git clone --depth 1 https://github.com/bats-core/bats-file /opt/homebrew/lib/bats-file
#   git clone --depth 1 https://github.com/bats-core/bats-support /opt/homebrew/lib/bats-support
# Then run this in the add-on root directory:
#   bats ./tests/test.bats
# To exclude release tests:
#   bats ./tests/test.bats --filter-tags '!release'
# For debugging:
#   bats ./tests/test.bats --show-output-of-passing-tests --verbose-run --print-output-on-failure

setup() {
  set -eu -o pipefail

  # Override this variable for your add-on:
  export GITHUB_REPO=egg2-code-labs/ddev-wp-devkit

  TEST_BREW_PREFIX="$(brew --prefix 2>/dev/null || true)"
  export BATS_LIB_PATH="${BATS_LIB_PATH}:${TEST_BREW_PREFIX}/lib:/usr/lib/bats"
  bats_load_library bats-assert
  bats_load_library bats-file
  bats_load_library bats-support

  export DIR="$(cd "$(dirname "${BATS_TEST_FILENAME}")/.." >/dev/null 2>&1 && pwd)"
  export PROJNAME="test-$(basename "${GITHUB_REPO}")"
  mkdir -p "${HOME}/tmp"
  export TESTDIR="$(mktemp -d "${HOME}/tmp/${PROJNAME}.XXXXXX")"
  export DDEV_NONINTERACTIVE=true
  export DDEV_NO_INSTRUMENTATION=true
  export CI=true
  ddev delete -Oy "${PROJNAME}" >/dev/null 2>&1 || true
  cd "${TESTDIR}"
  # wp-devkit's commands are restricted to WordPress projects
  run ddev config --project-name="${PROJNAME}" --project-tld=ddev.site --project-type=wordpress --create-docroot
  assert_success
  run ddev start -y
  assert_success
}

health_checks() {
  # wp-config.php is generated by the post-start hook and managed by wp-devkit
  run ddev wpdev status
  assert_success
  assert_output --partial "URL:            https://${PROJNAME}.ddev.site"
  assert_output --partial "wp-config.php:  managed by wp-devkit"

  # dbsync works without a configured remote
  run ddev dbsync status
  assert_success
  assert_output --partial "Remote:          <not set>"

  # Install WordPress and verify the wp-devkit helpers work end to end.
  # WordPress is downloaded on the host: api.wordpress.org TLS 1.3 handshakes
  # fail from OpenSSL 3.5 clients inside containers (curl error 35), while
  # host curl (Apple TLS) and everything after core install are unaffected.
  run curl -sfL --max-time 120 -o "${TESTDIR}/wp-latest.tar.gz" https://wordpress.org/latest.tar.gz
  assert_success
  run tar -xzf "${TESTDIR}/wp-latest.tar.gz" -C "${TESTDIR}" --strip-components=1
  assert_success
  run ddev wp core install --url="https://${PROJNAME}.ddev.site" --title="wp-devkit" --admin_user=instadmin --admin_password=instadmin --admin_email=instadmin@example.test --skip-email
  assert_success

  # Create the local dev admin
  run ddev wpdev admin devadmin devpass
  assert_success
  assert_output --partial "Created administrator 'devadmin'"

  # The dev admin can log in
  run ddev wp user get devadmin --field=roles
  assert_success
  assert_output --partial "administrator"

  # Content hash of a freshly installed database
  run ddev wpdev hash
  assert_success
  assert_output --regexp '[0-9a-f]{32}'

  # The site responds
  run curl -s -o /dev/null -w "%{http_code}" "https://${PROJNAME}.ddev.site"
  assert_output "200"
}

teardown() {
  set -eu -o pipefail
  ddev delete -Oy "${PROJNAME}" >/dev/null 2>&1
  # Persist TESTDIR if running inside GitHub Actions. Useful for uploading test result artifacts
  # See example at https://github.com/ddev/github-action-add-on-test#preserving-artifacts
  if [ -n "${GITHUB_ENV:-}" ]; then
    [ -e "${GITHUB_ENV:-}" ] && echo "TESTDIR=${HOME}/tmp/${PROJNAME}" >> "${GITHUB_ENV}"
  else
    [ "${TESTDIR}" != "" ] && rm -rf "${TESTDIR}"
  fi
}

@test "install from directory" {
  set -eu -o pipefail
  echo "# ddev add-on get ${DIR} with project ${PROJNAME} in $(pwd)" >&3
  run ddev add-on get "${DIR}"
  assert_success
  run ddev restart -y
  assert_success
  health_checks
}

# bats test_tags=release
@test "install from release" {
  set -eu -o pipefail
  # Requires a first release to exist (tagged 'release'; skipped until then so
  # scheduled runs on main do not fail before the first release is cut).
  if [ -z "$(git ls-remote --tags "https://github.com/${GITHUB_REPO}.git" 2>/dev/null)" ]; then
    skip "No GitHub release yet; cut a release (e.g. v0.1.0) to enable this test."
  fi
  echo "# ddev add-on get ${GITHUB_REPO} with project ${PROJNAME} in $(pwd)" >&3
  run ddev add-on get "${GITHUB_REPO}"
  assert_success
  run ddev restart -y
  assert_success
  health_checks
}
