#!/usr/bin/env bats

# Bats is a testing framework for Bash
# Documentation https://bats-core.readthedocs.io/en/stable/
# Bats libraries documentation https://github.com/ztombol/bats-docs

# For local tests, install bats-core (brew install bats-core) and the assertion
# libraries from their git repos (they are not on Homebrew), e.g. on macOS:
#   git clone --depth 1 https://github.com/bats-core/bats-assert /opt/homebrew/lib/bats-assert
#   git clone --depth 1 https://github.com/bats-core/bats-file /opt/homebrew/lib/bats-file
#   git clone --depth 1 https://github.com/bats-core/bats-support /opt/homebrew/lib/bats-support
# Then run this in the add-on root directory:
#   bats ./tests/test.bats
# To exclude release tests:
#   bats ./tests/test.bats --filter-tags '!release'
# For debugging:
#   bats ./tests/test.bats --show-output-of-passing-tests --verbose-run --print-output-on-failure

setup() {
  set -eu -o pipefail

  # Override this variable for your add-on:
  export GITHUB_REPO=egg2-code-labs/ddev-wp-devkit

  TEST_BREW_PREFIX="$(brew --prefix 2>/dev/null || true)"
  export BATS_LIB_PATH="${BATS_LIB_PATH}:${TEST_BREW_PREFIX}/lib:/usr/lib/bats"
  bats_load_library bats-assert
  bats_load_library bats-file
  bats_load_library bats-support

  export DIR="$(cd "$(dirname "${BATS_TEST_FILENAME}")/.." >/dev/null 2>&1 && pwd)"
  export PROJNAME="test-$(basename "${GITHUB_REPO}")"
  mkdir -p "${HOME}/tmp"
  export TESTDIR="$(mktemp -d "${HOME}/tmp/${PROJNAME}.XXXXXX")"
  export DDEV_NONINTERACTIVE=true
  export DDEV_NO_INSTRUMENTATION=true
  export CI=true
  ddev delete -Oy "${PROJNAME}" >/dev/null 2>&1 || true
  cd "${TESTDIR}"
  # wp-devkit's commands are restricted to WordPress projects
  run ddev config --project-name="${PROJNAME}" --project-tld=ddev.site --project-type=wordpress --create-docroot
  assert_success
  run ddev start -y
  assert_success
}

health_checks() {
  # wp-config.php is generated by the post-start hook and managed by wp-devkit
  run ddev wpdev status
  assert_success
  assert_output --partial "URL:            https://${PROJNAME}.ddev.site"
  assert_output --partial "wp-config.php:  managed by wp-devkit"

  # dbsync works without a configured remote
  run ddev dbsync status
  assert_success
  assert_output --partial "Remote:          <not set>"

  # Install WordPress and verify the wp-devkit helpers work end to end.
  # WordPress is downloaded on the host: api.wordpress.org TLS 1.3 handshakes
  # fail from OpenSSL 3.5 clients inside containers (curl error 35), while
  # host curl (Apple TLS) and everything after core install are unaffected.
  run curl -sfL --max-time 120 -o "${TESTDIR}/wp-latest.tar.gz" https://wordpress.org/latest.tar.gz
  assert_success
  run tar -xzf "${TESTDIR}/wp-latest.tar.gz" -C "${TESTDIR}" --strip-components=1
  assert_success
  run ddev wp core install --url="https://${PROJNAME}.ddev.site" --title="wp-devkit" --admin_user=instadmin --admin_password=instadmin --admin_email=instadmin@example.test --skip-email
  assert_success

  # Create the local dev admin
  run ddev wpdev admin devadmin devpass
  assert_success
  assert_output --partial "Created administrator 'devadmin'"

  # The dev admin can log in
  run ddev wp user get devadmin --field=roles
  assert_success
  assert_output --partial "administrator"

  # Content hash of a freshly installed database
  run ddev wpdev hash
  assert_success
  assert_output --regexp '[0-9a-f]{32}'

  # The site responds
  run curl -s -o /dev/null -w "%{http_code}" "https://${PROJNAME}.ddev.site"
  assert_output "200"
}

# HTTP request from inside the web container (cookie jar in /tmp/jar), prints the status code.
web() {
  ddev exec "curl -sk -c /tmp/jar -b /tmp/jar -o /dev/null -w '%{http_code}' $*"
}

edits_count() {
  ddev wpdev edits count
}

edit_detection_checks() {
  local url="https://${PROJNAME}.ddev.site"

  # Database sharing via a local folder, git hooks active
  echo "WPDEV_DB_REMOTE=${TESTDIR}/remote" > .ddev/.env.local
  printf 'wp-config.php\n.ddev/.env.local\nwp-latest.tar.gz\n' > .gitignore
  git init -q -b main
  git config user.name "Test Dev"
  git config user.email test@example.test
  run ddev dbsync install-hooks
  assert_success

  # WP-CLI writes count as edits ("wp core install" above)
  run ddev wpdev edits show
  assert_output --partial "cli core install"

  # The first commit exports a snapshot with the content-v1 hash policy and clears the edits
  run git add -A
  run git commit -qm "initial"
  assert_success
  assert_file_exists db/snapshot.json
  run grep '"hash_policy": "content-v1"' db/snapshot.json
  assert_success
  run edits_count
  assert_output "0"

  # Noise is not an edit: WP-CLI housekeeping, anonymous visitors, login, admin page views, heartbeat
  ddev wp transient set wpdev_test 1 >/dev/null
  web "${url}/" >/dev/null
  web "${url}/wp-login.php" >/dev/null
  run web -d "'log=instadmin&pwd=instadmin&wp-submit=Log+In&testcookie=1'" "${url}/wp-login.php"
  assert_output "302"
  web "${url}/wp-admin/" >/dev/null
  web -d "'action=heartbeat&interval=60&_nonce=x'" "${url}/wp-admin/admin-ajax.php" >/dev/null
  run edits_count
  assert_output "0"

  # A commit without edits creates no snapshot
  local pointer
  pointer="$(cat db/snapshot.json)"
  run git commit -q --allow-empty -m "no change"
  assert_success
  assert_equal "$(cat db/snapshot.json)" "${pointer}"

  # Saving settings is an edit, although the content hash does not change
  local hash_before nonce
  hash_before="$(ddev wpdev hash | tail -1)"
  nonce="$(ddev exec "curl -sk -b /tmp/jar ${url}/wp-admin/options-general.php" | grep -o 'name="_wpnonce" value="[^"]*"' | head -1 | sed 's/.*value="//;s/"//')"
  run web -d "'option_page=general&action=update&_wpnonce=${nonce}&blogname=Edited&blogdescription=x&siteurl=${url}&home=${url}&new_admin_email=instadmin@example.test&timezone_string=UTC&date_format=Y-m-d&time_format=H:i&start_of_week=1&WPLANG='" "${url}/wp-admin/options.php"
  assert_output "302"
  run ddev wp option get blogname
  assert_output "Edited"
  run ddev wpdev edits show
  assert_output --partial "POST /wp-admin/options.php action=update"
  assert_equal "$(ddev wpdev hash | tail -1)" "${hash_before}"
  run ddev dbsync status
  assert_output --partial "Local changes:   YES"

  run git commit -q --allow-empty -m "settings"
  assert_success
  refute [ "$(cat db/snapshot.json)" = "${pointer}" ]
  run edits_count
  assert_output "0"

  # Recorded edits protect the local database: checking out the first commit does not import
  ddev wp option update blogdescription "unsaved" >/dev/null
  run git checkout -q HEAD~2
  assert_output --partial "NOT importing"
  run ddev wp option get blogdescription
  assert_output "unsaved"

  # pull --force discards them
  run ddev dbsync pull --force
  assert_success
  run edits_count
  assert_output "0"
  run ddev wp option get blogname
  refute_output "Edited"

  # Changes wp-devkit cannot see are recorded by hand
  run ddev dbsync mark-dirty "direct SQL"
  assert_success
  run ddev wpdev edits show
  assert_output --partial "manual direct SQL"

  # The legacy policy still computes the hash of earlier wp-devkit versions
  run ddev wpdev hash --policy full-v1
  assert_success
  assert_output --regexp '[0-9a-f]{32}'
}

teardown() {
  set -eu -o pipefail
  ddev delete -Oy "${PROJNAME}" >/dev/null 2>&1
  # Persist TESTDIR if running inside GitHub Actions. Useful for uploading test result artifacts
  # See example at https://github.com/ddev/github-action-add-on-test#preserving-artifacts
  if [ -n "${GITHUB_ENV:-}" ]; then
    [ -e "${GITHUB_ENV:-}" ] && echo "TESTDIR=${HOME}/tmp/${PROJNAME}" >> "${GITHUB_ENV}"
  else
    [ "${TESTDIR}" != "" ] && rm -rf "${TESTDIR}"
  fi
}

@test "install from directory" {
  set -eu -o pipefail
  echo "# ddev add-on get ${DIR} with project ${PROJNAME} in $(pwd)" >&3
  run ddev add-on get "${DIR}"
  assert_success
  run ddev restart -y
  assert_success
  health_checks
  # Not part of health_checks: the release test runs them against the published version.
  edit_detection_checks
}

# bats test_tags=release
@test "install from release" {
  set -eu -o pipefail
  # Requires a first release to exist (tagged 'release'; skipped until then so
  # scheduled runs on main do not fail before the first release is cut).
  if [ -z "$(git ls-remote --tags "https://github.com/${GITHUB_REPO}.git" 2>/dev/null)" ]; then
    skip "No GitHub release yet; cut a release (e.g. v0.1.0) to enable this test."
  fi
  echo "# ddev add-on get ${GITHUB_REPO} with project ${PROJNAME} in $(pwd)" >&3
  run ddev add-on get "${GITHUB_REPO}"
  assert_success
  run ddev restart -y
  assert_success
  health_checks
}
